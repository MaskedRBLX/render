-- State
local enabled = true   -- Set to false if you want to add a toggle later
local activeConnections = {}   -- for cleanup
local updateDebounce = {}      -- prevent too frequent updates per player
local retryThread = nil

-- Clean up everything when disabled
local function removeAllKitRenders()
    for _, conn in ipairs(activeConnections) do
        conn:Disconnect()
    end
    table.clear(activeConnections)
    table.clear(updateDebounce)
    
    if retryThread then
        task.cancel(retryThread)
        retryThread = nil
    end
    
    -- Destroy all kit icons
    for _, v in ipairs(PlayerGui:GetDescendants()) do
        if v:IsA("ImageLabel") and v.Name == "AeroV4KitRender" then
            v:Destroy()
        end
    end
end

-- Create a new kit icon inside the opponent's card
local function createKitRender(plr)
    local icon = Instance.new("ImageLabel")
    icon.Name = "AeroV4KitRender"
    icon.AnchorPoint = Vector2.new(1, 0.5)
    icon.BackgroundTransparency = 1
    icon.Position = UDim2.new(1.05, 0, 0.5, 0)
    icon.Size = UDim2.new(1.5, 0, 1.5, 0)
    icon.SizeConstraint = Enum.SizeConstraint.RelativeYY
    icon.ImageTransparency = 0.4
    icon.ScaleType = Enum.ScaleType.Crop
    local uar = Instance.new("UIAspectRatioConstraint")
    uar.AspectRatio = 1
    uar.AspectType = Enum.AspectType.FitWithinMaxSize
    uar.DominantAxis = Enum.DominantAxis.Width
    uar.Parent = icon
    icon.Image = ids[plr:GetAttribute("PlayingAsKit")] or ids["none"]
    return icon
end

-- Update icon if kit changed
local function refreshIcon(icon, plr)
    if not icon or not icon.Parent then return end
    local kit = plr:GetAttribute("PlayingAsKit")
    local newImage = ids[kit] or ids["none"]
    if icon.Image ~= newImage then
        icon.Image = newImage
    end
end

-- Find the Roblox player from a label and its container
local function findPlayer(label, container)
    -- First try to get userId from the PlayerRender image (BedWars uses "rbxthumb://..." with id=)
    local render = container:FindFirstChild("PlayerRender", true)
    if render and render:IsA("ImageLabel") and render.Image then
        local userId = string.match(render.Image, "id=(%d+)")
        if userId then
            local plr = Players:GetPlayerByUserId(tonumber(userId))
            if plr then return plr end
        end
    end
    -- Fallback: match by name or display name
    local text = label.Text
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name == text or plr.DisplayName == text or plr:GetAttribute("DisguiseDisplayName") == text then
            return plr
        end
    end
end

-- Main logic for one opponent label
local function handleLabel(label)
    if not (label:IsA("TextLabel") and label.Name == "PlayerName") then return end
    
    task.spawn(function()
        -- Walk up to find the main container frame (3 levels up usually)
        local container = label.Parent
        for _ = 1, 3 do
            if container and container.Parent then
                container = container.Parent
            end
        end
        if not container or not container:IsA("Frame") then return end
        
        local playerFound = findPlayer(label, container)
        if not playerFound then
            task.wait(0.5)
            playerFound = findPlayer(label, container)
        end
        if not playerFound then return end
        
        container.Name = playerFound.Name  -- tag for debugging
        
        -- BedWars Draft player card structure: container -> "1" -> MatchDraftPlayerCard
        local card = container:FindFirstChild("1") and container["1"]:FindFirstChild("MatchDraftPlayerCard")
        if not card then return end
        
        local icon = card:FindFirstChild("AeroV4KitRender")
        if not icon then
            icon = createKitRender(playerFound)
            icon.Parent = card
        end
        
        -- Start update loop for this player
        local loopKey = playerFound.UserId
        if updateDebounce[loopKey] then return end  -- already being handled
        
        updateDebounce[loopKey] = true
        task.spawn(function()
            while enabled and container and container.Parent and icon and icon.Parent do
                local currentTick = tick()
                if not updateDebounce[loopKey] or (currentTick - (updateDebounce[loopKey] or 0)) >= 0.5 then
                    updateDebounce[loopKey] = currentTick
                    
                    -- Re-fetch player in case of disguise or name change
                    local updatedPlayer = findPlayer(label, container)
                    if updatedPlayer and updatedPlayer ~= playerFound then
                        playerFound = updatedPlayer
                    end
                    
                    refreshIcon(icon, playerFound)
                end
                task.wait(0.5)
            end
            updateDebounce[loopKey] = nil
        end)
    end)
end

-- Set up the hook into the draft UI
local function setupKitRender()
    local success, team2 = pcall(function()
        return PlayerGui:FindFirstChild("MatchDraftApp") and
               PlayerGui.MatchDraftApp:FindFirstChild("DraftAppBackground") and
               PlayerGui.MatchDraftApp.DraftAppBackground:FindFirstChild("BodyContainer") and
               PlayerGui.MatchDraftApp.DraftAppBackground.BodyContainer:FindFirstChild("Team2Column")
    end)
    
    if not success or not team2 then
        return false
    end
    
    -- Process existing player labels
    for _, child in ipairs(team2:GetDescendants()) do
        if not enabled then break end
        handleLabel(child)
    end
    
    -- Listen for new ones
    local conn = team2.DescendantAdded:Connect(function(child)
        if enabled then
            handleLabel(child)
        end
    end)
    table.insert(activeConnections, conn)
    
    return true
end


local function startKitRender()
    if not enabled then return end
    removeAllKitRenders()
    local success = setupKitRender()
    if not success then
        -- UI not ready yet, wait and try again
        retryThread = task.spawn(function()
            while enabled do
                task.wait(1)
                if setupKitRender() then
                    break
                end
            end
        end)
    end
end

-- Toggle function (optional)
function toggleEnabled(state)
    enabled = state
    if enabled then
        startKitRender()
    else
        removeAllKitRenders()
    end
end

-- Initial start
startKitRender()


local function onPlayerGuiChildAdded(child)
    if child.Name == "MatchDraftApp" and enabled then
        task.wait(0.1)
        removeAllKitRenders()
        startKitRender()
    end
end
PlayerGui.ChildAdded:Connect(onPlayerGuiChildAdded)

