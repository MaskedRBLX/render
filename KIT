-- Simple function to create/update the kit icon on a card
local function updateCard(card, player)
    local icon = card:FindFirstChild("AeroV4KitRender")
    if not icon then
        icon = Instance.new("ImageLabel")
        icon.Name = "AeroV4KitRender"
        icon.AnchorPoint = Vector2.new(1, 0.5)
        icon.BackgroundTransparency = 1
        icon.Position = UDim2.new(1.05, 0, 0.5, 0)
        icon.Size = UDim2.new(1.5, 0, 1.5, 0)
        icon.SizeConstraint = Enum.SizeConstraint.RelativeYY
        icon.ImageTransparency = 0.4
        icon.ScaleType = Enum.ScaleType.Crop
        local uar = Instance.new("UIAspectRatioConstraint")
        uar.AspectRatio = 1
        uar.AspectType = Enum.AspectType.FitWithinMaxSize
        uar.DominantAxis = Enum.DominantAxis.Width
        uar.Parent = icon
        icon.Parent = card
    end
    -- Set image based on current kit attribute
    local kit = player:GetAttribute("PlayingAsKit")
    local newImage = ids[kit] or ids["none"]
    if icon.Image ~= newImage then
        icon.Image = newImage
    end
end

-- Find the Roblox player from a card’s PlayerRender image
local function getPlayerFromCard(card)
    local render = card:FindFirstChild("PlayerRender", true)
    if render and render:IsA("ImageLabel") and render.Image then
        local userId = string.match(render.Image, "id=(%d+)")
        if userId then
            return Players:GetPlayerByUserId(tonumber(userId))
        end
    end
    -- Fallback: try PlayerName text
    local nameLabel = card:FindFirstChild("PlayerName", true)
    if nameLabel and nameLabel:IsA("TextLabel") then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Name == nameLabel.Text or plr.DisplayName == nameLabel.Text then
                return plr
            end
        end
    end
    return nil
end

-- Main loop: continuously scan for opponent cards and update them
local function mainLoop()
    local loadedPrinted = false
    while true do
        local draft = PlayerGui:FindFirstChild("MatchDraftApp")
        if draft then
            -- Collect all player cards in the draft UI
            local cards = {}
            for _, obj in ipairs(draft:GetDescendants()) do
                if obj:IsA("Frame") and obj.Name == "MatchDraftPlayerCard" then
                    table.insert(cards, obj)
                end
            end
            
            -- First time we find cards, print the confirmation
            if #cards > 0 and not loadedPrinted then
                print("KIT RENDER LOADED")
                loadedPrinted = true
            end
            
            -- Process each card (skip local player)
            for _, card in ipairs(cards) do
                local player = getPlayerFromCard(card)
                if player and player ~= LocalPlayer then
                    updateCard(card, player)
                end
            end
        else
      
            loadedPrinted = false
        end
        task.wait(0.3)  -- update 3 times per second → smooth enough
    end
end

-- Start the main loop in a background thread
task.spawn(mainLoop)
